# Loaded by uvicorn --env-file .env; CLI uses its inherited environment.
FINSENTINEL_ENV=development
FINSENTINEL_DATA_DIR=runtime
FINSENTINEL_DB_PATH=runtime/finsentinel.db
FINSENTINEL_MODEL_NAME=mistral:7b-instruct-q4_K_M
FINSENTINEL_EMBED_MODEL=all-MiniLM-L6-v2
FINSENTINEL_OFFLINE=1
FINSENTINEL_RERANKER=1
FINSENTINEL_REGISTRATION=1
FINSENTINEL_TOKEN_EXPIRY_MINUTES=60
FINSENTINEL_MAX_UPLOAD_BYTES=26214400
FINSENTINEL_MAX_PDF_PAGES=200
FINSENTINEL_INFERENCE=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate
FINSENTINEL_LLAMA_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
FINSENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# Also set this in the separately launched Ollama process.
OLLAMA_NO_CLOUD=1
# Development generates persistent random keys under the data directory.
# Production requires both variables (32+ random characters each).
# FINSENTINEL_JWT_SECRET=
# FINSENTINEL_ENCRYPTION_KEY=
